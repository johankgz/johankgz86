{
  "name": "Suivi travaux 360",
  "short_name": "Travaux 360",
  "description": "Le suivi des chantiers : relevés, suivis, plans et documents, sur le téléphone, la tablette et l'ordinateur.",
  "lang": "fr",
  "start_url": "/index.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F4F1EA",
  "theme_color": "#22201C",
  "icons": [
    {
      "src": "/icone-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icone-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icone-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Importer des plans et des documents",
      "short_name": "Importer",
      "url": "/importer.html",
      "icons": [{ "src": "/icone-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Exporter un chantier vers l'ordinateur",
      "short_name": "Exporter",
      "url": "/importer.html?onglet=exporter",
      "icons": [{ "src": "/icone-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Tous mes chantiers",
      "short_name": "Chantiers",
      "url": "/rapports.html",
      "icons": [{ "src": "/icone-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Cloud",
      "short_name": "Cloud",
      "url": "/cloud.html",
      "icons": [{ "src": "/icone-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "/importer.html",
      "accept": {
        "application/pdf": [".pdf"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "image/webp": [".webp"],
        "image/vnd.dwg": [".dwg"],
        "image/vnd.dxf": [".dxf"],
        "application/msword": [".doc"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/vnd.oasis.opendocument.text": [".odt"],
        "application/vnd.ms-excel": [".xls"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.oasis.opendocument.spreadsheet": [".ods"],
        "application/vnd.ms-powerpoint": [".ppt"],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"],
        "text/csv": [".csv"],
        "text/plain": [".txt"]
      },
      "launch_type": "single-client"
    }
  ]
}
